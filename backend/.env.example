# La API de IA solo se ejecuta en el servidor local.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Opcional: modelo de Gemini cuando LLM_PROVIDER es otro (vacío = LLM_MODEL).
GEMINI_MODEL=
LLM_MESSAGE_LIMIT=6
LLM_MAX_OUTPUT_TOKENS=1200
LLM_CONTEXT_CHARS=32000
OLLAMA_URL=http://127.0.0.1:11434
# Claude: LLM_PROVIDER=anthropic y tu clave de platform.claude.com (nunca la compartas).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=16000
# CONFIGURAR_SERVIDOR.cmd crea una clave de enlace aleatoria.
EXTENSION_ACCESS_TOKEN=

# PostgreSQL local: ejecutar CONFIGURAR_BASE_DATOS.cmd
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nexomail
DB_USER=nexomail_app
DB_PASSWORD=
